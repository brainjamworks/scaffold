  "programmaticCases": [
    { "name": "NaN scaled", "field": "scaled", "value": "nan" },
    { "name": "positive infinite scaled", "field": "scaled", "value": "positiveInfinity" },
    { "name": "negative infinite scaled", "field": "scaled", "value": "negativeInfinity" },
    { "name": "NaN raw", "field": "raw", "value": "nan" },
