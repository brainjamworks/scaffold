{
  "name": "@scaffold/adapter-moodle",
  "version": "0.0.0",
  "private": true,
  "description": "Moodle activity module adapter for Scaffold.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vp run check:artifacts && vp run build:unchecked",
    "build:unchecked": "vp build",
    "check:artifacts": "node scripts/sync-assessment-artifacts.mjs --check && node scripts/sync-learner-activity-artifact.mjs --check && node scripts/sync-third-party-libraries.mjs --check",
    "check:assessment-artifacts": "node scripts/sync-assessment-artifacts.mjs --check",
    "check:learner-activity-artifact": "node scripts/sync-learner-activity-artifact.mjs --check",
    "php:lint": "find scaffold -name '*.php' -print0 | xargs -0 -n1 php -l",
    "package": "python3 scripts/package.py --check && vp run verify && python3 scripts/package.py",
    "sync:assessment-artifacts": "node scripts/sync-assessment-artifacts.mjs --write",
    "sync:learner-activity-artifact": "node scripts/sync-learner-activity-artifact.mjs --write",
    "sync:third-party-libraries": "node scripts/sync-third-party-libraries.mjs --write",
    "test": "vp run check:artifacts && vp run test:unchecked",
    "test:unchecked": "vp test run --passWithNoTests && node --test tests/moodle-amd.node.mjs tests/repository-contracts.node.mjs tests/third-party-libraries.node.mjs && python3 -m unittest tests/test_package.py",
    "verify": "vp run check:artifacts && vp run php:lint && vp run test:unchecked && vp run build:unchecked"
  },
  "dependencies": {
    "@scaffold/contracts": "workspace:*",
    "@scaffold/core": "workspace:*",
    "katex": "^0.16.47",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "happy-dom": "^20.10.2",
    "typescript": "~5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4"
  }
}
